# ====================================================================
# AI Travel Companion — Environment Variables Configuration
# ====================================================================

# Backend Port
SERVER_PORT=8080

# Spring Active Profile (default = uses MySQL, or set to 'h2' for zero-setup demo)
SPRING_PROFILES_ACTIVE=default

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/travel_companion?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AI Provider API Keys (Optional - Heuristic & local AI engine automatically activates when absent)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=auto

# Spatial & Geo Mapping (Optional - Leaflet & CartoDB engine runs automatically without key)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Weather API (Optional - Open-Meteo keyless live weather runs out of the box)
WEATHER_API_KEY=your_weather_api_key_here
